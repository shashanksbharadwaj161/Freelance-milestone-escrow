{
  "name": "stableflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@stableflow/web",
    "build": "npm run build --workspace=@stableflow/web",
    "lint": "npm run lint --workspace=@stableflow/web",
    "test": "npm run test --workspace=@stableflow/contracts",
    "contracts:compile": "npm run compile --workspace=@stableflow/contracts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@next/env": "^16.3.6",
    "next": "^16.3.6"
  }
}
